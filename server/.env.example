# Copy this file to server/.env (git ignores .env) to configure your local server.
# Developer menu passkey for npm run dev. Use your own; on a public server use 12+ random characters.
DEV_PASSKEY=

# HvH panels for every HvH player without the passkey (equal capabilities, no administration).
# Default on; set to 0 to require the passkey in HvH too.
HVH_PUBLIC_PANEL=1
